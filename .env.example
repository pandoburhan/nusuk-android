# Database Configuration (MySQL XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nusuk_key

# ADB & Device Configuration
ADB_PATH=platform-tools/adb.exe
ADB_TARGET=192.168.100.8:5555
NUSUK_PACKAGE=com.moh.nusukapp
NUSUK_ACTIVITY=com.moh.nusukapp.activity.MainActivity

# AI Provider Configuration (OpenAI-Compatible: OpenAI, OpenRouter, Groq, DeepSeek, Ollama, etc.)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini

# Automation & Timing
LOADING_TIMEOUT_SECONDS=25
CIRCUIT_BREAKER_LIMIT=5
ACTION_DELAY_SECONDS=0.0

# Backend Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
